<!DOCTYPE html>
<html>

<head>
  <title>Telecommande Admin</title>
  <%- include('partials/header') %>
  <!-- Permet de ne pas faire de zoom 
    Lorsque l'admin est sur mobile et qu'il click sur un bouton plusieurs fois-->
  <meta name='viewport' content='user-scalable=0' />
</head>

<body class="admin-page">
  <div class="container">
    <div class="row justify-content-center">
      <div>
        <img src="./images/backgrounds/menus.svg" width="500px;" />
      </div>
    </div>
    <div class="jumbotron mt-4">
      <div class="row justify-content-center">
        <h1>Télécommande Admin</h1>
      </div>
      <div class="row justify-content-center mt-2">
        <h3><span id="buzzer-status" class="badge badge-secondary p-2">Buzzer bloqué</span></h3>
        <span id="connection-status" class="badge badge-danger ml-2 align-self-start">Déconnecté…</span>
      </div>
      <div class="row mt-4">
        <div class="col-lg-4 col-sm-6 text-center">
          <input id="button-add-point-ketchup" type="button" class="base-button button-ketchup" value="+" />
          <input id="button-remove-point-ketchup" type="button" class="base-button button-ketchup" value="-" />
        </div>
        <div class="col-lg-4 col-sm-4 text-center">
          <input id="button-buzz-bad-response" type="button" class="base-button button-ketchup" value="X" />
        </div>
        <div class="col-lg-4 col-sm-6 text-center">
          <input id="button-add-point-mayo" type="button" class="base-button button-mayo" value="+" />
          <input id="button-remove-point-mayo" type="button" class="base-button button-mayo" value="-" />
        </div>
      </div>
      <div class="row justify-content-center mt-4">
        <input class="btn btn-secondary btn-lg mr-2" type="button" value="Transition précédente" id="button-previous-transition" disabled />
        <input class="btn btn-success btn-lg" type="button" value="Transition suivante" id="button-next-transition" />
      </div>
      <div class="row justify-content-center mt-2">
        <small id="transition-status" class="text-muted"></small>
      </div>
      <div class="card mt-4" id="question-panel">
        <div class="card-header d-flex flex-wrap align-items-center">
          <label class="mb-0 mr-2" for="select-party"><strong>Partie</strong></label>
          <select class="form-control form-control-sm w-auto mr-2" id="select-party">
            <option value="">— Aucune —</option>
          </select>
          <a class="btn btn-sm btn-outline-secondary ml-auto" href="/admin/parties">Gérer les parties et questions</a>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted" id="question-status"></small>
            <div class="btn-group">
              <button type="button" class="btn btn-outline-secondary" id="button-previous-question" disabled>&larr; Précédente</button>
              <button type="button" class="btn btn-outline-secondary" id="button-next-question" disabled>Suivante &rarr;</button>
            </div>
          </div>
          <div id="question-content" hidden>
            <small class="text-muted d-block" id="question-theme"></small>
            <p class="h4" id="question-text"></p>
            <ol type="A" class="h5 font-weight-normal" id="question-choices"></ol>
            <p class="h5 text-success mb-0" id="question-answer"></p>
            <div class="mt-3" id="media-controls" hidden>
              <button type="button" class="btn btn-outline-info mr-2 mb-1" id="button-play-question-media"></button>
              <button type="button" class="btn btn-outline-info mr-2 mb-1" id="button-play-answer-media"></button>
              <button type="button" class="btn btn-outline-secondary mb-1" id="button-stop-media">&#9632; Stop</button>
            </div>
            <div class="mt-3" id="screen-controls" hidden>
              <button type="button" class="btn btn-outline-primary mr-2 mb-1" id="button-toggle-screen-question">Masquer de l'écran</button>
              <button type="button" class="btn btn-outline-success mb-1" id="button-toggle-reveal-answer">Révéler la réponse à l'écran</button>
            </div>
          </div>
        </div>
      </div>
      <div class="row justify-content-center mt-4">
        <input class="btn btn-success btn-lg mr-2" type="button" value="Débloquer buzzer" id="button-unlock-buzz" />
        <input class="btn btn-secondary btn-lg" type="button" value="Bloquer buzzer" id="button-lock-buzz" />
      </div>
      <div class="row justify-content-center mt-4">
        <input class="btn btn-success btn-lg" type="button" value="Recharger partie" data-toggle="modal" data-target="#modal-reload-part" />
      </div>
      <div class="row justify-content-center mt-4 d-none d-md-flex">
        <small class="text-muted text-center">
          Raccourcis : <kbd>K</kbd> / <kbd>Maj+K</kbd> point Ketchup ±,
          <kbd>M</kbd> / <kbd>Maj+M</kbd> point Mayo ±, <kbd>X</kbd> mauvaise réponse,
          <kbd>D</kbd> débloquer, <kbd>B</kbd> bloquer,
          <kbd>N</kbd> transition suivante, <kbd>P</kbd> précédente,
          <kbd>&rarr;</kbd> / <kbd>&larr;</kbd> question suivante / précédente,
          <kbd>E</kbd> afficher / masquer la question à l'écran, <kbd>R</kbd> révéler la réponse,
          <kbd>J</kbd> / <kbd>Maj+J</kbd> jouer le son / la vidéo de la question / de la réponse, <kbd>S</kbd> l'arrêter
        </small>
      </div>
      <div class="row justify-content-center mt-2">
        <a class="btn btn-link" href="/logout">Se déconnecter</a>
      </div>
    </div>
  </div>
  <!-- Modal de reload partie -->
  <div class="modal fade" id="modal-reload-part" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Recharger une partie</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Es-tu sur de vouloir recharger la partie ?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
          <button type="button" class="btn btn-primary" id="button-reload-part">Continuer</button>
        </div>
      </div>
    </div>
  </div>
</body>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/messages-socket.js"></script>
<script src="./js/client-admin.js"></script>

</html>