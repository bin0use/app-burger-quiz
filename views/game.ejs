<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Burger Quiz</title>
    <link href="/css/fonts/cabin-sketch.css" rel="stylesheet" />
    <link href="/css/game.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/images/favicons/favicon.ico" />
</head>

<body class="game-page">
    <!-- Scène 16:9 (1920 x 1080) mise à l'échelle de l'écran : rendu identique sur toutes les TV -->
    <div id="stage">
        <!-- Bandeau des scores -->
        <header id="scoreboard">
            <div class="scoreboard-team scoreboard-ketchup">
                <img src="/images/teams/ketchup.svg" alt="" class="scoreboard-logo" />
                <span class="scoreboard-name">Ketchup</span>
                <span class="scoreboard-score" id="score-ketchup">0</span>
            </div>
            <div class="scoreboard-round" id="scoreboard-round">Burger Quiz</div>
            <div class="scoreboard-team scoreboard-mayo">
                <span class="scoreboard-score" id="score-mayo">0</span>
                <span class="scoreboard-name">Mayo</span>
                <img src="/images/teams/mayo.svg" alt="" class="scoreboard-logo" />
            </div>
        </header>

        <!-- Plateaux des équipes : le burger se remplit élément par élément (25 points) -->
        <main id="trays">
            <section class="tray" id="tray-ketchup" data-team="team-ketchup"></section>
            <section class="tray" id="tray-mayo" data-team="team-mayo"></section>
        </main>

        <!-- Burger de la mort : la tour se construit à chaque bonne réponse -->
        <div id="death-burger" hidden>
            <div class="death-burger-title" id="death-burger-title">Burger de la mort</div>
            <div class="death-burger-tower" id="death-burger-tower"></div>
            <div class="death-burger-count" id="death-burger-count">0 / 10</div>
        </div>

        <!-- Question (Nuggets, noms puis questions des menus, propositions de Sel ou Poivre) -->
        <section id="question-panel" hidden>
            <div class="question-header">
                <span class="question-round" id="question-round"></span>
                <span class="question-points" id="question-points" hidden></span>
            </div>
            <div class="question-text" id="question-text"></div>
            <div class="question-choices" id="question-choices"></div>
            <div class="question-answer" id="question-answer" hidden></div>
            <div class="question-menus" id="question-menus" hidden></div>
        </section>

        <!-- Chrono circulaire -->
        <div id="timer" hidden>
            <svg viewBox="0 0 200 200" aria-hidden="true">
                <circle class="timer-track" cx="100" cy="100" r="88" />
                <circle class="timer-ring" id="timer-ring" cx="100" cy="100" r="88" />
            </svg>
            <span class="timer-value" id="timer-value"></span>
        </div>

        <!-- Carton de manche -->
        <div id="round-card" hidden>
            <div class="round-card-content">
                <div class="round-card-number" id="round-card-number"></div>
                <div class="round-card-label" id="round-card-label"></div>
                <div class="round-card-rules" id="round-card-rules"></div>
            </div>
        </div>

        <!-- Mauvaise réponse -->
        <div id="bad-answer" hidden>&#10007;</div>

        <!-- Equipe ayant buzzé en premier (et écart avec l'autre équipe) -->
        <div id="buzz-first" hidden>
            <img id="buzz-first-logo" alt="" />
            <div id="buzz-first-name"></div>
            <div id="buzz-first-gap"></div>
        </div>

        <!-- Ecran de victoire -->
        <div id="victory" hidden>
            <div id="confetti"></div>
            <div class="victory-content">
                <div class="victory-title" id="victory-title"></div>
                <img class="victory-logo" id="victory-logo" alt="" />
                <div class="victory-scores">
                    <span class="victory-score victory-score-ketchup" id="victory-score-ketchup">0</span>
                    <span class="victory-score victory-score-mayo" id="victory-score-mayo">0</span>
                </div>
                <table class="victory-recap" id="victory-recap">
                    <thead><tr><th></th><th class="victory-recap-ketchup">Ketchup</th><th class="victory-recap-mayo">Mayo</th></tr></thead>
                    <tbody id="victory-recap-rounds"></tbody>
                </table>
                <div class="victory-buzzes" id="victory-buzzes"></div>
            </div>
        </div>

        <!-- Vidéo d'une question ou d'une réponse -->
        <div id="media" hidden>
            <video id="video-media" playsinline></video>
        </div>

        <!-- Transition entre les manches -->
        <div id="transition" hidden>
            <video id="video-transition" playsinline></video>
        </div>

        <!-- Préparation : QR code d'accès au choix des équipes -->
        <div id="prepare">
            <img class="prepare-logo" src="/images/backgrounds/burger_quiz_title.png" alt="Burger Quiz" />
            <p class="prepare-title">
                <span class="prepare-ketchup">Ketchup,</span>
                <span class="prepare-mayo">Mayo,</span>
                <span class="prepare-both">ou les deux ?</span>
            </p>
            <% if (qrCodeDataUrl) { %>
            <img class="prepare-qr" src="<%= qrCodeDataUrl %>" alt="<%= urlToGenerate %>"
                title="Flashez le QR code pour choisir votre équipe" />
            <p class="prepare-help">Flashez le QR code pour choisir votre équipe</p>
            <% } %>
            <button type="button" class="prepare-button" id="button-everybody-ready">Tout le monde est prêt !</button>
        </div>

        <!-- Bordure aux couleurs de l'équipe qui a la main -->
        <div id="hand-border"></div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/messages-socket.js"></script>
    <script src="/js/client-game.js"></script>
</body>

</html>
