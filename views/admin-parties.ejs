<!DOCTYPE html>
<html>

<head>
  <title>Gestion des parties</title>
  <%- include('partials/header') %>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<body class="admin-page" data-media-max-size="<%= limits.mediaSize %>">
  <div class="container-fluid py-4">
    <div class="jumbotron py-4 mb-0">
      <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <h1 class="h2 mb-0">Gestion des parties</h1>
        <div>
          <a class="btn btn-outline-secondary" href="/admin">Retour à la télécommande</a>
          <a class="btn btn-link" href="/logout">Se déconnecter</a>
        </div>
      </div>
      <div id="alert-container"></div>
      <div class="row">
        <!-- Liste des parties -->
        <div class="col-lg-4 mb-4">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <strong>Parties</strong>
              <div>
                <button type="button" class="btn btn-sm btn-success" id="button-new-party">Nouvelle partie</button>
                <label class="btn btn-sm btn-outline-secondary mb-0" title="Importer un fichier exporté">
                  Importer <input type="file" id="input-import-party" accept="application/json,.json" hidden />
                </label>
              </div>
            </div>
            <div class="list-group list-group-flush" id="party-list"></div>
            <div class="card-body text-muted" id="party-list-empty">
              Aucune partie pour le moment : créez-en une pour y ajouter des questions.
            </div>
          </div>
        </div>

        <!-- Détail de la partie sélectionnée -->
        <div class="col-lg-8">
          <div class="card" id="party-detail" hidden>
            <div class="card-header">
              <form class="form-inline" id="form-rename-party">
                <label class="sr-only" for="input-party-name">Nom de la partie</label>
                <input type="text" class="form-control mr-2 mb-2 flex-grow-1" id="input-party-name"
                  maxlength="<%= limits.name %>" required />
                <button type="submit" class="btn btn-primary mr-2 mb-2">Renommer</button>
                <button type="button" class="btn btn-outline-secondary mr-2 mb-2" id="button-duplicate-party">Dupliquer</button>
                <a class="btn btn-outline-secondary mr-2 mb-2" id="link-export-party" href="#">Exporter</a>
                <button type="button" class="btn btn-outline-danger mb-2" id="button-delete-party">Supprimer</button>
              </form>
            </div>
            <div class="card-body">
              <ul class="nav nav-tabs" id="round-tabs">
                <% rounds.forEach(function (round, index) { %>
                <li class="nav-item">
                  <a class="nav-link<%= index === 0 ? ' active' : '' %>" href="#" data-round="<%= round.key %>">
                    <%= round.label %> <span class="badge badge-pill badge-secondary" data-count="<%= round.key %>">0</span>
                  </a>
                </li>
                <% }) %>
              </ul>
              <div class="d-flex flex-wrap align-items-center mt-3" id="selection-toolbar">
                <div class="custom-control custom-checkbox mr-3">
                  <input type="checkbox" class="custom-control-input" id="input-select-all" />
                  <label class="custom-control-label" for="input-select-all">Tout sélectionner</label>
                </div>
                <small class="text-muted mr-3" id="selection-count"></small>
                <button type="button" class="btn btn-sm btn-outline-primary" id="button-transfer" disabled>Copier / déplacer vers une autre partie…</button>
              </div>
              <ol class="list-group mt-2" id="question-list"></ol>
              <p class="text-muted mt-3" id="question-list-empty">Aucune question dans cette manche.</p>
              <button type="button" class="btn btn-success mt-2" id="button-new-question">Ajouter une question</button>
            </div>
          </div>
          <div class="card" id="party-placeholder">
            <div class="card-body text-muted">Sélectionnez une partie pour gérer ses questions.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal d'ajout / modification d'une question -->
  <div class="modal fade" id="modal-question" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
      <form class="modal-content" id="form-question">
        <div class="modal-header">
          <h5 class="modal-title" id="modal-question-title">Question</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="input-question-round">Manche</label>
            <select class="form-control" id="input-question-round" required>
              <% rounds.forEach(function (round) { %>
              <option value="<%= round.key %>"><%= round.label %><%= round.screenMode === 'question' ? ' (affichée à l\'écran)' : round.screenMode === 'choices' ? ' (thème et propositions affichés à l\'écran)' : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="input-question-theme">Thème <small class="text-muted">(optionnel : nom du menu, « Johnny, Eddy ou les deux ? »…)</small></label>
            <input type="text" class="form-control" id="input-question-theme" maxlength="<%= limits.theme %>" />
          </div>
          <div class="form-group">
            <label for="input-question-text">Question</label>
            <textarea class="form-control" id="input-question-text" rows="3" maxlength="<%= limits.question %>" required></textarea>
          </div>
          <div class="form-group" data-media="questionMedia">
            <label>Son ou vidéo de la question <small class="text-muted">(optionnel, joué sur l'écran de jeu depuis la télécommande)</small></label>
            <div class="mb-2" data-media-preview></div>
            <div class="d-flex flex-wrap align-items-center">
              <label class="btn btn-sm btn-outline-secondary mb-0 mr-2">
                <span data-media-choose>Choisir un fichier</span> <input type="file" accept="audio/*,video/*" data-media-input hidden />
              </label>
              <button type="button" class="btn btn-sm btn-outline-danger mr-2" data-media-remove hidden>Retirer</button>
              <small class="text-muted" data-media-status></small>
            </div>
          </div>
          <div class="form-group" id="question-choices">
            <label>Propositions <small class="text-muted">(optionnel, affichées à l'écran pour les Nuggets, Sel ou Poivre et les menus : cochez la bonne réponse)</small></label>
            <% for (let index = 0; index < limits.choices; index++) { %>
            <div class="input-group mb-1">
              <div class="input-group-prepend">
                <div class="input-group-text">
                  <input type="radio" name="question-good-choice" value="<%= index %>" aria-label="Bonne réponse" title="Bonne réponse" />
                </div>
                <span class="input-group-text"><%= String.fromCharCode(65 + index) %></span>
              </div>
              <input type="text" class="form-control" data-choice="<%= index %>" maxlength="<%= limits.choice %>" />
            </div>
            <% } %>
          </div>
          <div class="form-group">
            <label for="input-question-answer">Réponse</label>
            <textarea class="form-control" id="input-question-answer" rows="2" maxlength="<%= limits.answer %>"></textarea>
          </div>
          <div class="form-group" data-media="answerMedia">
            <label>Son ou vidéo de la réponse <small class="text-muted">(optionnel, joué sur l'écran de jeu depuis la télécommande)</small></label>
            <div class="mb-2" data-media-preview></div>
            <div class="d-flex flex-wrap align-items-center">
              <label class="btn btn-sm btn-outline-secondary mb-0 mr-2">
                <span data-media-choose>Choisir un fichier</span> <input type="file" accept="audio/*,video/*" data-media-input hidden />
              </label>
              <button type="button" class="btn btn-sm btn-outline-danger mr-2" data-media-remove hidden>Retirer</button>
              <small class="text-muted" data-media-status></small>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-sm-3 mb-0">
              <label for="input-question-points">Points <small class="text-muted">(miams)</small></label>
              <select class="form-control" id="input-question-points">
                <% for (let points = 1; points <= limits.points; points++) { %>
                <option value="<%= points %>"><%= points %></option>
                <% } %>
              </select>
            </div>
            <div class="form-group col-sm-9 mb-0">
              <label for="input-question-note">Note de l'animateur <small class="text-muted">(optionnel, visible seulement sur la télécommande)</small></label>
              <textarea class="form-control" id="input-question-note" rows="2" maxlength="<%= limits.note %>"
                placeholder="Une blague, une précision, une anecdote…"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary" id="button-save-question">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de copie / déplacement de questions vers une autre partie -->
  <div class="modal fade" id="modal-transfer" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <form class="modal-content" id="form-transfer">
        <div class="modal-header">
          <h5 class="modal-title" id="modal-transfer-title">Copier / déplacer</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="input-transfer-target">Vers la partie</label>
            <select class="form-control" id="input-transfer-target" required></select>
          </div>
          <div class="custom-control custom-radio">
            <input type="radio" class="custom-control-input" name="transfer-mode" id="input-transfer-copy" value="copy" checked />
            <label class="custom-control-label" for="input-transfer-copy">Copier <small class="text-muted">(les questions restent aussi dans cette partie)</small></label>
          </div>
          <div class="custom-control custom-radio">
            <input type="radio" class="custom-control-input" name="transfer-mode" id="input-transfer-move" value="move" />
            <label class="custom-control-label" for="input-transfer-move">Déplacer <small class="text-muted">(les questions sont retirées de cette partie)</small></label>
          </div>
          <small class="form-text text-muted">Les questions sont ajoutées à la fin de leur manche, avec leur thème, leurs sons et vidéos.</small>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Valider</button>
        </div>
      </form>
    </div>
  </div>
</body>
<script src="/js/client-admin-parties.js"></script>

</html>
